NEXT_PUBLIC_SITE_URL=https://6mlab.com

# Stripe (dashboard.stripe.com > Developers > API keys). Use the test key (sk_test_...) for now.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint pointing to /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_...
# Live keys (sk_live_...) are refused unless this is set to 1: fill in lib/legal.ts first.
# STRIPE_ALLOW_LIVE=1

# Automatic emails after payment (Gmail). The app password is created in your Google account:
# Security > 2-Step Verification (must be on) > App passwords.
GMAIL_USER=6mlab.contact@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_DRY_RUN=1 builds the emails without sending them (local development).
