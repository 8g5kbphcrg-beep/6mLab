NEXT_PUBLIC_SITE_URL=https://6mlab.com

# Stripe (dashboard.stripe.com > Developers > API keys). Use the test key (sk_test_...) for now.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint pointing to /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_...
# Live keys (sk_live_...) are refused unless this is set to 1: fill in lib/legal.ts first.
# STRIPE_ALLOW_LIVE=1

# Automatic emails after payment, sent from iCloud Mail. The app-specific password is created at
# appleid.apple.com > Sign-In and Security > App-Specific Passwords.
# MAIL_USER is the login: for iCloud, the main address of the Apple account (not an alias).
MAIL_USER=adresse-principale@icloud.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Address the emails are sent from (and where order summaries arrive), e.g. an iCloud alias.
MAIL_FROM=sixmlab.contact@icloud.com
# MAIL_SERVICE=gmail to send from Gmail instead (with a Google app password).
# MAIL_DRY_RUN=1 builds the emails without sending them (local development).
